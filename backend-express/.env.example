NODE_ENV=development
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/village-academy

# JWT
# Use a long random secret (minimum 32 characters in production)
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Application
DEFAULT_FEE_AMOUNT=4000

# CORS - comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10