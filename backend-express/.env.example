NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/village-academy

# Use a long random string (min 32 chars required in production)
SECRET_KEY=dev-only-secret-key-change-before-production-deploy-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

DEFAULT_FEE_AMOUNT=4000

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:8000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
